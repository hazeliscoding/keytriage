{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "keytriage",
  "version": "../package.json",
  "identifier": "io.github.hazeliscoding.keytriage",
  "build": {
    "frontendDist": "../dist/keytriage/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "keytriage",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "incognito": true,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hazel Granados",
    "copyright": "Copyright 2026 Hazel Granados",
    "homepage": "https://github.com/hazeliscoding/keytriage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    }
  }
}
